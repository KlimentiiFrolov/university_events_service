# Значения по умолчанию для запуска в docker compose.
# Скопировать в .env и поправить под локальный запуск (хосты -> localhost).

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_EXCHANGE=university.events
NOTIFICATION_QUEUE=notifications
NOTIFICATION_ROUTING_KEYS=["registration.*", "event.*"]
NOTIFICATION_PREFETCH_COUNT=10

# Своя БД уведомлений (контейнер notifications_db)
NOTIFICATIONS_DB_NAME=notifications
NOTIFICATIONS_DB_USER=notifications
NOTIFICATIONS_DB_PASSWORD=change_me
NOTIFICATIONS_DB_HOST=notifications_db
NOTIFICATIONS_DB_PORT=5432

# Должны совпадать с api_service: сервис проверяет выданные им токены
JWT_SECRET=change_me
JWT_ALGORITHM=HS256

NOTIFICATION_HOST=0.0.0.0
NOTIFICATION_PORT=8001
