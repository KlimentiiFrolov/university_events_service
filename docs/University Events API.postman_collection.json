              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "const eventId = Number(\r",
                  "    pm.collectionVariables.get(\"eventId\")\r",
                  ");\r",
                  "\r",
                  "pm.test(\"response contains items\", () => {\r",
                  "    pm.expect(body.items).to.be.an(\"array\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"current event is in my registrations\", () => {\r",
                  "    const found = body.items.some(\r",
                  "        item => item.event_id === eventId\r",
                  "    );\r",
                  "\r",
                  "    pm.expect(found).to.eql(true);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
