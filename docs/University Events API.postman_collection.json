      "name": "Registrations",
      "item": [
        {
          "name": "Register for event",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", () => {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "const body = pm.response.json();\r",
                  "\r",
                  "pm.test(\"registration is active\", () => {\r",
                  "    pm.expect(body.status).to.eql(\"active\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"registration belongs to current event\", () => {\r",
                  "    pm.expect(body.event_id).to.eql(\r",
                  "        Number(pm.collectionVariables.get(\"eventId\"))\r",
                  "    );\r",
                  "});\r",
                  "\r",
                  "pm.collectionVariables.set(\r",
                  "    \"registrationId\",\r",
                  "    body.id\r",
                  ");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
