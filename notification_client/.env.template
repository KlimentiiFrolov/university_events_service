# Run from Docker Compose:
NOTIFICATION_WS_URL=ws://notification_service:8001/ws/notifications
API_BASE_URL=http://api_service:8000

# Credentials of an existing account (e.g. an organizer) from api_service.
# Keep real values in notification_client/.env, never commit them.
NOTIFICATION_EMAIL=
NOTIFICATION_PASSWORD=

# Alternative to email/password: a short-lived access JWT.
# Do not set if using credentials (login refreshes token on reconnect).
NOTIFICATION_TOKEN=

RECONNECT_INITIAL_SECONDS=1.0
RECONNECT_MAX_SECONDS=30.0
